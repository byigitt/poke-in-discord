# ── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot.
# Enable the "MESSAGE CONTENT INTENT" toggle on that same page, or the bot
# cannot read message text.
DISCORD_TOKEN=

# ── Persona ──────────────────────────────────────────────────────────────────
# What the assistant calls itself.
POKE_BOT_NAME=Poke

# ── Model (resolved through pi's own auth — no API keys needed here) ──────────
# Credentials come from your pi/omp login (`omp auth-broker login` or local
# `~/.omp/agent/agent.db`). Leave POKE_MODEL empty to auto-pick a good default.
# Example: anthropic/claude-sonnet-4-5
POKE_MODEL=
# off | minimal | low | medium | high | xhigh | auto   (off = snappiest texting)
POKE_THINKING=off

# ── Behavior ─────────────────────────────────────────────────────────────────
# In servers, reply to: "mention" (only when @mentioned or replied to) or "all".
# Direct messages are always answered.
POKE_RESPOND_TO=mention

# Directory where per-conversation chat history is persisted (gives the bot
# memory across restarts).
POKE_SESSION_DIR=.sessions

# Drop an idle conversation from memory after this many minutes (history stays
# on disk and resumes on the next message).
POKE_SESSION_IDLE_MINUTES=30

# Max number of separate Discord messages one reply may be split into.
POKE_MAX_REPLY_MESSAGES=5

# ── Images ───────────────────────────────────────────────────────────────────
# When you attach photos (jpeg/png/gif/webp), the bot forwards them to the model
# so it can actually see them — as long as the resolved model accepts images
# (the default Claude models do). These cap what gets forwarded per message.
# Largest single attachment to download and forward, in megabytes.
POKE_MAX_IMAGE_MB=8
# Most images forwarded from one message (extras are ignored).
POKE_MAX_IMAGES=4

# ── Files (the bot can browse, search, read, and SEND files from this machine) ─
# The assistant can find a file on this computer and upload it to Discord.
# IMPORTANT: this is real file access — it can read and send ANY file under the
# root below to whoever it's talking to. Keep the bot private (DMs / your own
# server) and/or narrow the root if that matters. Defaults to your home folder.
# POKE_FILES_ROOT=/Users/you/Documents
# Largest file (MB) the bot will read inline or upload. Discord's own limit also
# applies (about 8 MB without a boosted server).
POKE_FILES_MAX_MB=8

# ── Connected accounts (OAuth) ───────────────────────────────────────────────
# Apps like Google Calendar are loaded ONLY when their credentials are present
# below — otherwise the bot simply doesn't offer them. Users link their own
# account from chat with `connect <app>` (e.g. `connect google-calendar`).
#
# The bot runs a tiny local server to catch the OAuth redirect. This port and
# base URL must match the redirect URI you register with each provider:
#   <POKE_OAUTH_REDIRECT_BASE>/oauth/callback
POKE_OAUTH_PORT=8787
# Public base URL the provider redirects back to. Default http://localhost:<port>
# (fine for running locally). Set this to your domain/tunnel if the bot is remote.
# POKE_OAUTH_REDIRECT_BASE=https://your-host.example.com
# Where linked-account tokens are stored (SQLite). Default: <session dir>/connections.db
# POKE_CONNECTIONS_FILE=.sessions/connections.db

# Google (Calendar, …): create an OAuth client at https://console.cloud.google.com
# (APIs & Services → Credentials → OAuth client ID → Web application), enable the
# Google Calendar API, and add <POKE_OAUTH_REDIRECT_BASE>/oauth/callback as an
# authorized redirect URI. Leave blank to disable all Google integrations.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Long tail (Notion, Linear, GitHub, Sentry, …): not env vars — drop a standard
# `.mcp.json` next to the bot (same format Cursor/Claude use) and every MCP
# server's tools are loaded on startup. No `.mcp.json` ⇒ MCP stays off.

# Optional: override pi's agent config dir (defaults to ~/.omp/agent).
# POKE_AGENT_DIR=
