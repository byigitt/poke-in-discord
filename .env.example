# ── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot.
# Enable the "MESSAGE CONTENT INTENT" toggle on that same page, or the bot
# cannot read message text.
DISCORD_TOKEN=

# ── Persona ──────────────────────────────────────────────────────────────────
# What the assistant calls itself.
POKE_BOT_NAME=Poke

# ── Model (resolved through pi's own auth — no API keys needed here) ──────────
# Credentials come from your pi/omp login (`omp auth-broker login` or local
# `~/.omp/agent/agent.db`). Leave POKE_MODEL empty to auto-pick a good default.
# Example: anthropic/claude-sonnet-4-5
POKE_MODEL=
# off | minimal | low | medium | high | xhigh | auto   (off = snappiest texting)
POKE_THINKING=off

# ── Behavior ─────────────────────────────────────────────────────────────────
# In servers, reply to: "mention" (only when @mentioned or replied to) or "all".
# Direct messages are always answered.
POKE_RESPOND_TO=mention

# Directory where per-conversation chat history is persisted (gives the bot
# memory across restarts).
POKE_SESSION_DIR=.sessions

# Drop an idle conversation from memory after this many minutes (history stays
# on disk and resumes on the next message).
POKE_SESSION_IDLE_MINUTES=30

# Max number of separate Discord messages one reply may be split into.
POKE_MAX_REPLY_MESSAGES=5

# ── Images ───────────────────────────────────────────────────────────────────
# When you attach photos (jpeg/png/gif/webp), the bot forwards them to the model
# so it can actually see them — as long as the resolved model accepts images
# (the default Claude models do). These cap what gets forwarded per message.
# Largest single attachment to download and forward, in megabytes.
POKE_MAX_IMAGE_MB=8
# Most images forwarded from one message (extras are ignored).
POKE_MAX_IMAGES=4

# Optional: override pi's agent config dir (defaults to ~/.omp/agent).
# POKE_AGENT_DIR=
